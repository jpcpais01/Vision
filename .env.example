# ─────────────────────────────────────────────────────────────
# Vision — Polymarket BTC 5m UP/DOWN trading system
# Copy to .env.local for local dev; set the same keys in Vercel
# Project Settings -> Environment Variables for deployment.
# Every value here is server-side only. None are NEXT_PUBLIC_.
#
# PAPER mode needs none of these — every variable below is either
# optional or only needed for LIVE trading.
# ─────────────────────────────────────────────────────────────

# --- Dashboard access control (strongly recommended) ----------------
# If set, every /api route requires header `x-vision-token: <value>`
# and the UI asks for it once and keeps it in sessionStorage.
VISION_ACCESS_TOKEN=

# --- LIVE trading credentials (only needed for LIVE mode) -----------
# Polygon private key of the wallet that holds USDC.e and is
# registered with Polymarket. NEVER prefix with NEXT_PUBLIC_.
POLYMARKET_PRIVATE_KEY=
# Optional: if your funds live in a Polymarket proxy / Safe wallet,
# put that address here and set the signature type accordingly.
POLYMARKET_FUNDER_ADDRESS=
# 0 = EOA, 1 = email/magic proxy wallet, 2 = browser wallet Safe proxy
POLYMARKET_SIGNATURE_TYPE=0
# Optional: pre-derived L2 API credentials. If omitted they are
# derived from the private key on first use.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Hard server-side guard. LIVE orders are rejected unless this is "true",
# regardless of what the UI requests.
ALLOW_LIVE_TRADING=false

# --- Endpoints (defaults are the official public ones) --------------
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CHAIN_ID=137

# --- CoinGecko price feed (optional but recommended) -----------------
# The barrier and live price both come from CoinGecko's free BTC/USD
# index (see src/lib/coingecko.ts). Works with no key at a low rate
# limit; a free Demo key from coingecko.com (no payment) raises it.
COINGECKO_API_KEY=

# --- Optional durable storage (Upstash Redis) -----------------------
# Without these the app keeps state in process memory, which is wiped
# on every serverless cold start. Set them for persistent history.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
